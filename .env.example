# ─────────────────────────────────────────────────────────────────────────────
# VedAarna Studio — Storefront (TanStack Start, deployed via Wrangler)
#
# DEPLOY PIPELINE: local npm run build → npx wrangler deploy
# Vite reads VITE_* from .env.production at build time and bakes them into
# the Worker bundle. They are NOT set in Cloudflare's dashboard UI.
#
# LOCAL DEV:   copy to .env.local  (*.local is gitignored)
# PRODUCTION:  copy to .env.production  (also gitignored — see .gitignore)
#              then: npm run build && npx wrangler deploy
#
# NEVER commit .env.production or .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Medusa backend ────────────────────────────────────────────────────────────
# The Railway backend URL. No trailing slash.
VITE_MEDUSA_BACKEND_URL=https://vedaarna-studio-production.up.railway.app

# Publishable API key from Medusa admin — safe to expose client-side by design.
# Create via: POST /admin/api-keys { "title": "Storefront", "type": "publishable" }
VITE_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
