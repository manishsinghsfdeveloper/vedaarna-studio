# ─────────────────────────────────────────────────────────────────────────────
# VedAarna Studio — Storefront (TanStack Start, deployed via Lovable)
#
# LOCAL DEV: copy to .env.local — Vite loads it automatically, .env.local is
# in .gitignore (covered by *.local rule).
#
# PRODUCTION: this project is built and deployed by Lovable's cloud pipeline.
# VITE_* vars are NOT read from Cloudflare's dashboard env vars UI (that only
# applies to Worker runtime secrets, not build-time Vite injection).
# Set them at: lovable.dev → your project → Settings → Environment Variables
# Then trigger a redeploy from Lovable for the values to be baked in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Medusa backend ────────────────────────────────────────────────────────────
# The Railway backend URL. No trailing slash.
VITE_MEDUSA_BACKEND_URL=https://vedaarna-studio-production.up.railway.app

# Publishable API key from Medusa admin — safe to expose client-side by design.
# Create via: POST /admin/api-keys { "title": "Storefront", "type": "publishable" }
VITE_MEDUSA_PUBLISHABLE_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
